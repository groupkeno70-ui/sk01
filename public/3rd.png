<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <!-- Luxurious 3D Bronze & Brass Gradients -->
    <linearGradient id="bronzeGold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f5deb3" />
      <stop offset="25%" stop-color="#cd7f32" />
      <stop offset="50%" stop-color="#a0522d" />
      <stop offset="75%" stop-color="#6e3b15" />
      <stop offset="100%" stop-color="#d28e46" />
    </linearGradient>
    <linearGradient id="bronzeDark" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#4a2408" />
      <stop offset="50%" stop-color="#2e1502" />
      <stop offset="100%" stop-color="#180a00" />
    </linearGradient>
    <radialGradient id="bronzeFlower" cx="35%" cy="35%" r="65%">
      <stop offset="0%" stop-color="#ffe0b2" />
      <stop offset="50%" stop-color="#cd7f32" />
      <stop offset="100%" stop-color="#5d2e0a" />
    </radialGradient>
    <filter id="bronzeGlow" x="-25%" y="-25%" width="150%" height="150%">
      <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#000000" flood-opacity="0.75"/>
    </filter>
  </defs>

  <g filter="url(#bronzeGlow)">
    <!-- Circular Carved Antique Bronze Outer Frame -->
    <circle cx="256" cy="256" r="185" fill="none" stroke="url(#bronzeGold)" stroke-width="16" />
    <circle cx="256" cy="256" r="170" fill="none" stroke="#df9b56" stroke-width="3" opacity="0.8"/>
    <circle cx="256" cy="256" r="198" fill="none" stroke="#4a2408" stroke-width="3" stroke-dasharray="4,6" />

    <!-- Ornate Baroque Foliage & Golden Blossoms All Around Rim -->
    <g fill="url(#bronzeGold)" stroke="#2e1502" stroke-width="1.5">
      <!-- Top Baroque Flower & Foliage -->
      <circle cx="256" cy="65" r="18" fill="url(#bronzeFlower)" />
      <circle cx="238" cy="56" r="13" fill="url(#bronzeFlower)"/>
      <circle cx="274" cy="56" r="13" fill="url(#bronzeFlower)"/>
      <circle cx="256" cy="46" r="13" fill="url(#bronzeFlower)"/>
      <circle cx="256" cy="65" r="6" fill="#301503"/>

      <!-- Left Top Florals -->
      <path d="M 180 88 Q 130 55 155 25 Q 195 50 180 88 Z" />
      <circle cx="155" cy="50" r="10" fill="url(#bronzeFlower)"/>
      <path d="M 115 155 Q 60 130 85 90 Q 132 110 115 155 Z" />
      <circle cx="95" cy="135" r="13" fill="url(#bronzeFlower)"/>

      <!-- Right Top Florals -->
      <path d="M 332 88 Q 382 55 357 25 Q 317 50 332 88 Z" />
      <circle cx="357" cy="50" r="10" fill="url(#bronzeFlower)"/>
      <path d="M 397 155 Q 452 130 427 90 Q 380 110 397 155 Z" />
      <circle cx="417" cy="135" r="13" fill="url(#bronzeFlower)"/>

      <!-- Left Middle Florals -->
      <path d="M 80 250 Q 25 235 40 190 Q 92 200 80 250 Z" />
      <circle cx="68" cy="235" r="14" fill="url(#bronzeFlower)"/>
      <path d="M 85 345 Q 38 360 52 405 Q 100 385 85 345 Z" />
      <circle cx="75" cy="362" r="13" fill="url(#bronzeFlower)"/>

      <!-- Right Middle Florals -->
      <path d="M 432 250 Q 487 235 472 190 Q 420 200 432 250 Z" />
      <circle cx="444" cy="235" r="14" fill="url(#bronzeFlower)"/>
      <path d="M 427 345 Q 474 360 460 405 Q 412 385 427 345 Z" />
      <circle cx="437" cy="362" r="13" fill="url(#bronzeFlower)"/>

      <!-- Bottom Flanking Leaves -->
      <path d="M 145 435 Q 110 480 155 498 Q 180 450 145 435 Z" />
      <path d="M 367 435 Q 402 480 357 498 Q 332 450 367 435 Z" />
    </g>

    <!-- Bottom Ornate Antique Bronze Plaque Cartouche -->
    <g id="cartouche3rd" transform="translate(0, 10)">
      <!-- Ornate Outer Frame with Scalloped / Filigree Trim -->
      <rect x="150" y="370" width="212" height="95" rx="26" fill="url(#bronzeGold)" stroke="#260f00" stroke-width="4"/>
      
      <!-- Inner Dark Recessed Inset -->
      <rect x="162" y="382" width="188" height="71" rx="18" fill="url(#bronzeDark)" stroke="#e6be8a" stroke-width="2"/>

      <!-- 4 Corner Baroque Filigree Rosettes -->
      <circle cx="166" cy="386" r="8" fill="url(#bronzeFlower)"/>
      <circle cx="346" cy="386" r="8" fill="url(#bronzeFlower)"/>
      <circle cx="166" cy="449" r="8" fill="url(#bronzeFlower)"/>
      <circle cx="346" cy="449" r="8" fill="url(#bronzeFlower)"/>

      <!-- 3rd Text with Cursive Font Style -->
      <text x="256" y="434" font-family="'Brush Script MT', 'Palatino Linotype', 'Times New Roman', cursive, Georgia, serif" font-style="italic" font-weight="bold" font-size="48" fill="url(#bronzeGold)" stroke="#1c0a00" stroke-width="1.2" text-anchor="middle">3rd</text>
    </g>
  </g>
</svg>